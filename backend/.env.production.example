# Copie para backend/.env.production e preencha.
# NAO reaproveite os segredos do backend/.env de desenvolvimento — gere novos.
# Os valores de senha/usuário do MinIO devem ser IGUAIS aos definidos em .env.production (raiz).

# Banco de dados — DB_HOST é o nome do serviço no docker-compose, não muda
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=oficinasync
DB_USER=sa
DB_PASSWORD=mesma-senha-do-.env.production-da-raiz

# MinIO — MINIO_ENDPOINT é o nome do serviço no docker-compose, não muda
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=mesmo-usuario-minio-do-.env.production-da-raiz
MINIO_SECRET_KEY=mesma-senha-minio-do-.env.production-da-raiz
MINIO_BUCKET=oficinasync
# Endereço público do MinIO (via Caddy) — usado só pra gerar as URLs assinadas
# das fotos/vídeos que o navegador acessa. Precisa do registro DNS "storage".
MINIO_PUBLIC_URL=https://storage.oficinasync.com.br

# App
PORT=3000
NODE_ENV=production

# Pepper — gere um valor novo e aleatório (ex: openssl rand -hex 32), nunca reaproveite o de dev
PASSWORD_PEPPER=troque-por-um-valor-aleatorio-novo

# Resend (envio de email) — pode reaproveitar a chave de dev se for a mesma conta
RESEND_KEY=

# JWT — gere um valor novo e aleatório (ex: openssl rand -hex 32), nunca reaproveite o de dev
JWT_SECRET=troque-por-um-valor-aleatorio-novo
JWT_EXPIRES_IN=1d
JWT_ONBOARDING_EXPIRES_IN=900

FRONTEND_URL=https://oficinasync.com.br
CORS_ORIGINS=https://oficinasync.com.br
BACKEND_URL=https://api.oficinasync.com.br
