# Copie para backend/.env e troque TODOS os valores. Nunca commite o .env real.
# Gere segredos com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Banco (SQL Server)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=oficinasync
DB_USER=sa
DB_PASSWORD=troque-esta-senha

# MinIO (armazenamento de fotos/vídeos/áudios)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=troque-este-usuario
MINIO_SECRET_KEY=troque-esta-senha
MINIO_BUCKET=oficinasync

# Autenticação
JWT_SECRET=gere-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1d
JWT_ONBOARDING_EXPIRES_IN=900
PASSWORD_PEPPER=gere-outro-segredo-longo-e-aleatorio

# E-mail (Resend)
RESEND_KEY=

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
